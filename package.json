{
  "name": "sast-integration",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env NEXT_PUBLIC_MOCK_DATA=true next dev",
    "build": "next build",
    "build:css": "npx antd-tools run compile",
    "build:prod": "pnpm build:css && pnpm build",
    "analyze": "cross-env ANALYZE=true next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --project unit",
    "test:e2e": "vitest run --project e2e",
    "test:ui": "playwright test",
    "test:ui:headed": "playwright test --headed",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:all": "vitest run --project unit --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx drizzle/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx drizzle/seed.ts",
    "db:reset": "tsx drizzle/reset.ts && drizzle-kit push --force && tsx drizzle/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:scan-finding:clear": "tsx scripts/clear-findings-scans.ts",
    "db:repo:clear": "tsx scripts/clear-repositories.ts",
    "backfill:nvd": "tsx scripts/backfill-nvd.ts",
    "docs:index": "node scripts/generate-search-index.js"
  },
  "dependencies": {
    "@ant-design/cssinjs": "^2.1.2",
    "@ant-design/icons": "^6.2.5",
    "@aws-sdk/client-s3": "^3.1057.0",
    "@aws-sdk/s3-request-presigner": "^3.1057.0",
    "@fortawesome/fontawesome-free": "^7.3.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.1",
    "antd": "^6.4.5",
    "axios": "^1.18.1",
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.9.3",
    "fuse.js": "^7.4.2",
    "jose": "^6.2.3",
    "jszip": "^3.10.1",
    "mermaid": "^11.15.0",
    "next": "16.2.9",
    "next-mdx-remote": "^6.0.0",
    "nodemailer": "^9.0.1",
    "pdfkit": "^0.19.1",
    "pg-boss": "^12.23.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-hook-form": "^7.80.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "remark-gfm": "^4.0.1",
    "zod": "^4.4.3"
  },
  "pnpm": {
    "overrides": {
      "form-data": "4.0.6",
      "undici": "7.28.0",
      "vite": "8.0.16"
    }
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.2.9",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vite": "8.0.16",
    "vitest": "^4.1.9"
  }
}
