# Database
DATABASE_URL=postgresql://user:password@localhost:5432/sast_db

# Server
PORT=3000
NODE_ENV=development
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info
# Log output: console, file, both (default: console)
LOG_DESTINATION=console
# Log directory (default: logs)
LOG_DIR=logs
# Log rotation: daily, none (default: daily)
LOG_ROTATION=daily

# Auth
JWT_SECRET=your-secret-key-minimum-32-characters-long!!
JWT_EXPIRES_IN=15m
REFRESH_EXPIRES_IN=7d

# Rate Limiting
# Set to 'false' to disable rate limiting (for testing/development)
RATE_LIMIT_ENABLED=true

# Allow AI model URLs on localhost/127.0.0.1 (for local Ollama, default: true)
ALLOW_LOCAL_AI_MODELS=true

# Mail
MAIL_PROVIDER=console
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@sast.local

# Seeder (optional — used by `pnpm db:seed`)
# Bootstrap owner. REQUIRED in production (seed refuses defaults when NODE_ENV=production).
OWNER_EMAIL=owner@sast.local
OWNER_PASSWORD=ChangeMe123!
OWNER_NAME=Owner
# Organization workspace (seeded only when WORKSPACE_MODE=single)
ORG_NAME=SAST Organization
ORG_SLUG=sast-org

# ─── Client-safe (NEXT_PUBLIC_) ───────────────────────────────
# Server reads these too — single source of truth, no duplication.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
NEXT_PUBLIC_MOCK_DATA=false
# single = one org workspace (invite-only, no self-signup); multiple = users self-signup + create workspaces
NEXT_PUBLIC_WORKSPACE_MODE=multiple
# Feature flags — set to "true" to enable, "false" or omit to disable
NEXT_PUBLIC_FEATURE_FLAG_SCAN_MANAGED=true
NEXT_PUBLIC_FEATURE_FLAG_SCAN_EXTERNAL_UPLOAD=true
NEXT_PUBLIC_FEATURE_FLAG_AI_VERIFICATION=true
NEXT_PUBLIC_FEATURE_FLAG_QUALITY_GATES=true
NEXT_PUBLIC_FEATURE_FLAG_TEAMS=true
NEXT_PUBLIC_FEATURE_FLAG_PROJECTS=true
NEXT_PUBLIC_FEATURE_FLAG_KNOWLEDGE_BASE=true
NEXT_PUBLIC_FEATURE_FLAG_SCHEDULES=false
NEXT_PUBLIC_FEATURE_FLAG_SOURCE_CONTROL_GITHUB=true
NEXT_PUBLIC_FEATURE_FLAG_SOURCE_CONTROL_GITLAB=true
NEXT_PUBLIC_FEATURE_FLAG_SOURCE_CONTROL_GITEA=true
NEXT_PUBLIC_FEATURE_FLAG_WEBHOOKS=false
NEXT_PUBLIC_FEATURE_FLAG_SCAN_PROFILES=true
NEXT_PUBLIC_FEATURE_FLAG_SCANNER_ENGINES=true
NEXT_PUBLIC_FEATURE_FLAG_AI_MODELS=true
NEXT_PUBLIC_FEATURE_FLAG_REPORTS=true
NEXT_PUBLIC_FEATURE_FLAG_ARENA=false

# ─── Storage ──────────────────────────────────────────────────
# Provider: local, s3, cloudinary (default: local)
STORAGE_PROVIDER=local
# Local storage path (optional, default: ./storage)
STORAGE_LOCAL_PATH=./storage
# S3/MinIO (required when STORAGE_PROVIDER=s3)
S3_BUCKET=sast-uploads
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=
# Cloudinary (required when STORAGE_PROVIDER=cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=sast
